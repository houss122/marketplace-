import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { MessageCircle, Home, PlusSquare, Search, Settings } from "lucide-react";

export default function MarketplaceApp() {
  const [tab, setTab] = useState("home");

  const NavButton = ({ id, icon: Icon, label }) => (
    <button
      onClick={() => setTab(id)}
      className={`flex flex-col items-center justify-center flex-1 p-2 ${tab===id?"text-blue-600":"text-gray-500"}`}
    >
      <Icon size={22} />
      <span className="text-xs">{label}</span>
    </button>
  );

  const HomePage = () => (
    <div className="grid gap-4">
      {[1,2,3].map((i)=> (
        <Card key={i} className="rounded-2xl shadow">
          <CardContent className="p-4">
            <div className="text-lg font-semibold">Item Title {i}</div>
            <div className="text-sm text-gray-500">Description of the item...</div>
            <div className="mt-2 font-bold">€100</div>
            <Button className="mt-3">Message Seller</Button>
          </CardContent>
        </Card>
      ))}
    </div>
  );

  const MessagesPage = () => (
    <div className="space-y-3">
      {["Alice","John","Maria"].map((name)=> (
        <Card key={name} className="rounded-2xl">
          <CardContent className="p-3 flex justify-between">
            <span>{name}</span>
            <MessageCircle size={18}/>
          </CardContent>
        </Card>
      ))}
    </div>
  );

  const AddPage = () => (
    <div className="space-y-3">
      <Input placeholder="Title of item" />
      <Input placeholder="Price" />
      <Input placeholder="Category (car, clothes, etc)" />
      <Input placeholder="Size / model" />
      <Button className="w-full">Publish</Button>
    </div>
  );

  const SearchPage = () => (
    <div className="space-y-3">
      <Input placeholder="Search item" />
      <Input placeholder="Price max" />
      <Input placeholder="Category" />
      <Input placeholder="Size / model" />
      <Button className="w-full">Apply filters</Button>
    </div>
  );

  const SettingsPage = () => (
    <div className="space-y-4">
      <Button className="w-full">Language</Button>
      <Button className="w-full">Dark / Light mode</Button>
      <Button className="w-full">Terms of service</Button>
      <Button className="w-full">Privacy</Button>
    </div>
  );

  const renderPage = () => {
    switch(tab){
      case "home": return <HomePage/>;
      case "messages": return <MessagesPage/>;
      case "add": return <AddPage/>;
      case "search": return <SearchPage/>;
      case "settings": return <SettingsPage/>;
      default: return <HomePage/>;
    }
  };

  return (
    <div className="max-w-md mx-auto p-4 pb-20">
      {renderPage()}

      <div className="fixed bottom-0 left-0 right-0 bg-white border-t flex">
        <NavButton id="home" icon={Home} label="Home" />
        <NavButton id="search" icon={Search} label="Search" />
        <NavButton id="add" icon={PlusSquare} label="Sell" />
        <NavButton id="messages" icon={MessageCircle} label="Chat" />
        <NavButton id="settings" icon={Settings} label="Settings" />
      </div>
    </div>
  );
}
